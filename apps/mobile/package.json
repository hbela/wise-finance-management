{
  "name": "@standalone-finance/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- expo start",
    "start": "dotenv -e ../../.env.local -- expo start",
    "start:lan": "dotenv -e ../../.env.local -- expo start --lan",
    "start:tunnel": "dotenv -e ../../.env.local -- expo start --tunnel",
    "android": "dotenv -e ../../.env.local -- expo start --android",
    "ios": "dotenv -e ../../.env.local -- expo start --ios",
    "web": "dotenv -e ../../.env.local -- expo start --web",
    "web:clear": "dotenv -e ../../.env.local -- expo start --web --clear",
    "web:isolated-proxy": "node ./scripts/isolated-web-proxy.mjs",
    "gen:icons": "node ./scripts/generate-icons.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/curves": "^1.9.7",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.10",
    "drizzle-orm": "^0.45.2",
    "expo": "^54.0.23",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-local-authentication": "~17.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.33.5"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
