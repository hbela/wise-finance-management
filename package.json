{
  "name": "standalone-finance-management",
  "version": "0.1.0",
  "private": true,
  "main": "apps/mobile/index.ts",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./apps/mobile/node_modules",
        "./node_modules"
      ]
    }
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "start": "npm run start -w @standalone-finance/mobile",
    "start:mobile": "npm run start -w @standalone-finance/mobile",
    "web:clear": "npm run web:clear -w @standalone-finance/mobile",
    "android": "npm run android -w @standalone-finance/mobile",
    "ios": "npm run ios -w @standalone-finance/mobile",
    "web": "npm run web -w @standalone-finance/mobile",
    "deploy:bridge": "npm run deploy -w @standalone-finance/bridge"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "dependencies": {
    "expo-dev-client": "~6.0.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  }
}
